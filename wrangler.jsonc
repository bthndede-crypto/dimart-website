{
  "name": "dimart-website",
  "compatibility_date": "2026-10-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "dimartmimarlik.com", "custom_domain": true },
    { "pattern": "www.dimartmimarlik.com", "custom_domain": true }
  ]
}
